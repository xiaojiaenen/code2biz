{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "部署任务状态机",
    "subtitle": "DeployTask：一次部署任务的生命周期（core/deploy_executor.py + api/deploy.py）",
    "output": "deploy-task-lifecycle.html",
    "locale": "zh-CN",
    "quality_profile": "showcase",
    "viewBox": [1010, 660]
  },
  "lanes": [
    { "id": "main", "label": "创建阶段" },
    { "id": "exec", "label": "后台执行线程" },
    { "id": "terminal", "label": "终态" }
  ],
  "states": [
    { "id": "pending", "type": "start", "label": "pending", "sublabel": "任务已创建", "lane": "main", "col": 0, "step": "01" },
    { "id": "running", "type": "active", "label": "running", "sublabel": "顺序执行每步 playbook", "lane": "exec", "col": 1, "step": "02" },
    { "id": "success", "type": "success", "label": "success", "sublabel": "所有步骤成功", "lane": "terminal", "col": 0, "tag": "终态" },
    { "id": "partial", "type": "decision", "label": "partial", "sublabel": "部分成功/失败", "lane": "terminal", "col": 1, "tag": "终态" },
    { "id": "failed", "type": "failure", "label": "failed", "sublabel": "存在失败/异常", "lane": "terminal", "col": 2, "tag": "终态" }
  ],
  "transitions": [
    { "id": "t-pending-running", "from": "pending", "to": "running", "label": "start_deploy()" },
    { "id": "t-running-success", "from": "running", "to": "success", "label": "全 step=success", "variant": "emphasis", "route": "top-channel", "channelY": 340, "labelDy": 22 },
    { "id": "t-running-partial", "from": "running", "to": "partial", "label": "有成功也有失败", "route": "top-channel" },
    { "id": "t-running-failed", "from": "running", "to": "failed", "label": "全失败/异常", "route": "top-channel" }
  ],
  "cards": [
    { "dot": "emerald", "title": "终态判定", "items": ["any_failed && any_success → partial", "any_failed → failed", "全部成功 → success"] },
    { "dot": "rose", "title": "失败处理", "items": ["某步失败立即停止后续步骤（有依赖）", "playbook 超时 3600s 取消并失败", "no hosts matched 视为失败"] },
    { "dot": "amber", "title": "单步重试", "items": ["POST /deploy/{id}/retry/{i}", "把该 step 改回 pending → 重跑 → 重新算终态"] }
  ]
}